{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/UsernameIsJoe/massing-explorer/schemas/massing-response.schema.json",
  "title": "MassingResponse",
  "description": "LLM/ML output describing proposed building massing to reconstruct in Rhino.",
  "type": "object",
  "required": ["version", "units", "proposals"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "units": {
      "type": "string",
      "enum": ["meters", "millimeters", "feet", "inches"]
    },
    "rationale": {
      "type": "string",
      "description": "Brief explanation of design decisions for human review."
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/proposal" }
    }
  },
  "definitions": {
    "proposal": {
      "type": "object",
      "required": ["id", "name", "volumes"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "gfa": { "type": "number", "description": "Gross floor area estimate." },
        "far_achieved": { "type": "number" },
        "coverage": { "type": "number", "description": "Site coverage ratio 0-1." },
        "volumes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/volume" }
        }
      }
    },
    "volume": {
      "type": "object",
      "required": ["footprint", "height"],
      "properties": {
        "name": { "type": "string" },
        "footprint": {
          "type": "array",
          "description": "Closed polygon in world XY.",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 3
          },
          "minItems": 3
        },
        "height": { "type": "number" },
        "base_elevation": { "type": "number", "default": 0 },
        "setbacks": {
          "type": "object",
          "description": "Per-edge setback distances if stepped massing.",
          "additionalProperties": { "type": "number" }
        },
        "floors": { "type": "integer" },
        "floor_to_floor": { "type": "number" },
        "use": {
          "type": "string",
          "enum": ["residential", "office", "retail", "mixed", "parking", "other"]
        }
      }
    }
  }
}
